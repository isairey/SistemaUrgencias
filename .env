APP_NAME=SistemaUrgenciaAdulto
APP_ENV=local
APP_KEY=base64:D8kZ50hOxCFs9lJA3y9Zccvwc0FVNm5VnfzEOzIQ+4c=
APP_DEBUG=true
APP_TIMEZONE=America/Santiago
APP_URL=http://localhost:8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =========================
# Base de datos
# =========================
DB_CONNECTION=mysql

# Dentro de Docker, usa el nombre del contenedor
DB_HOST=urgencia_mysql
DB_PORT=3306

# Desde Windows/localhost, descomenta estas líneas y comenta las de arriba
# DB_HOST=127.0.0.1
# DB_PORT=3307

DB_DATABASE=urgencia_adulto
DB_USERNAME=urgencia_user
DB_PASSWORD=Urg3ncia2025!

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# =========================
# Mail
# =========================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =========================
# Broadcast / Soketi
# =========================
BROADCAST_DRIVER=pusher

PUSHER_APP_ID=app-id
PUSHER_APP_KEY=app-key
PUSHER_APP_SECRET=app-secret
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
#PUSHER_APP_HOST=localhost
#PUSHER_APP_PORT=6001
#PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# =========================
# Redis
# =========================
# Cache, colas y sesiones (puedes dejar sesiones en DB si prefieres)
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis  # o redis si quieres todo en Redis

# Redis
REDIS_HOST=urgencia_redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# =========================
# Vite / Frontend
# =========================
VITE_PUSHER_APP_KEY=app-key
VITE_PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_HOST=localhost
VITE_PUSHER_PORT=6001
VITE_PUSHER_USE_TLS=false

VITE_APP_NAME="SistemaUrgenciaAdulto"
VITE_HOST=localhost
